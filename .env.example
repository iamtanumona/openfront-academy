# Copy these to apps/api/.env and apps/web/.env respectively.
# API
DATABASE_URL=postgresql://ofa:ofa_local_only@localhost:5432/ofa
PORT=3001
HOST=0.0.0.0
NODE_ENV=development
WEB_ORIGIN=http://localhost:4321
AUTH_ISSUER=https://YOUR_PROJECT.supabase.co/auth/v1
AUTH_AUDIENCE=authenticated
# Web (public, non-secret)
PUBLIC_API_BASE_URL=http://localhost:3001/v1
PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLIC_PUBLISHABLE_KEY
