{
  "name": "@ofa/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:seed:curriculum": "tsx src/db/seed-curriculum.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.4",
    "@ofa/contracts": "workspace:*",
    "dotenv": "^17.2.3",
    "hono": "^4.9.9",
    "pg": "^8.16.3",
    "zod": "^4.1.11",
    "jose": "^6.1.0",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
