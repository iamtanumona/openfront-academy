---
interface Crumb { label: string; href?: string }
const { items } = Astro.props as {items:Crumb[]};
---
<nav aria-label="Breadcrumb"><ol>{items.map((item,index)=><li>{item.href?<a href={item.href}>{item.label}</a>:<span aria-current="page">{item.label}</span>}{index<items.length-1&&<span aria-hidden="true"> / </span>}</li>)}</ol></nav><style>ol{display:flex;flex-wrap:wrap;list-style:none;padding:0;gap:.35rem;color:#4b5563}li{display:inline-flex;gap:.35rem}</style>
